# Copy to .env and fill in. Never commit .env; this file holds placeholders only.
# Full descriptions: README.md -> "Environment Variables & Configuration".

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Used by docker-compose to create the Postgres container.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=msykmembershipdb
# Local dev: localhost. Inside docker-compose: the database service name.
DATABASE_URL="postgresql://postgres:change-me@localhost:5432/msykmembershipdb?schema=public"

# ---------------------------------------------------------------------------
# App (required)
# ---------------------------------------------------------------------------
# Long random strings. Generate with: openssl rand -hex 32
SESSION_SECRET=
JWT_SECRET=
WAIVER_ENCRYPTION_KEY=
# Where Stripe and email links send people back to. Dev: http://localhost:5173/
BASE_URL=http://localhost:5173/
NODE_ENV=development

# ---------------------------------------------------------------------------
# Stripe (required). Test keys locally (sk_test_/pk_test_), live keys only in production.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_
STRIPE_PUBLIC_KEY=pk_test_

# ---------------------------------------------------------------------------
# Email via Mailgun (required)
# ---------------------------------------------------------------------------
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM_EMAIL=

# Development safety net. When set, every email goes to this address instead of the
# real recipient. With NODE_ENV=development and this unset, no email is sent at all.
# NEVER set this in production.
EMAIL_DEV_REDIRECT=you@example.com

# ---------------------------------------------------------------------------
# Google Calendar sync (optional)
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5173/api/google-calendar/callback
# At least 32 characters; encrypts the stored refresh token.
GOOGLE_OAUTH_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Brivo door access (optional). The integration stays off unless the first five are set.
# ---------------------------------------------------------------------------
BRIVO_CLIENT_ID=
BRIVO_CLIENT_SECRET=
BRIVO_USERNAME=
BRIVO_PASSWORD=
BRIVO_API_KEY=
# Defaults: https://api.brivo.com/v1/api and https://auth.brivo.com
BRIVO_BASE_URL=
BRIVO_AUTH_BASE_URL=
BRIVO_WEBHOOK_SECRET=
# Comma-separated Brivo group ids; the admin setting brivo_access_group_level4 wins if set.
BRIVO_ACCESS_GROUP_LEVEL4=
